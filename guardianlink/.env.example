# Template only. Copy to an ignored local .env and set a unique local/test DB password.
# Never reuse local credentials in staging/production; never commit tokens, private keys,
# personal data, precise location, or FCM/provider credentials.
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/guardianlink_local
DB_USER=guardianlink_local
DB_PASS=
DATA_DIR=./.local/guardianlink-data
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Web dev proxy is server-side only. Keep API calls same-origin in production.
API_PROXY_TARGET=http://127.0.0.1:8080
VITE_API_BASE_URL=

# Template note: the current backend does not read JWT_CONFIG/FCM_CONFIG/
# STORAGE_CONFIG/ENCRYPTION_CONFIG. Their names are not active provider integration.
# The Ed25519 JWK is persisted beneath DATA_DIR; protect it as a local private key.
# FCM/provider delivery is not configured by this example.
