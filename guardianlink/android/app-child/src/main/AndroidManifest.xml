<?xml version="1.0" encoding="utf-8"?>
<!--
  اپ فرزند: بدون مجوز اعلان و بدون سرویس foreground دائمی.
  دسترسی‌های Phase 3/4/6 در پایین با disclosure و مسیر رسمی Android اعلام شده‌اند.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Phase 6: broad installed-package inventory is a sensitive Google Play permission.
      Distribution must satisfy Play's approved core-use declaration/review; otherwise visibility
      can be filtered by Android. No permission prompt or hidden workaround is used.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      Phase 3: آمار مصرف اپ‌ها (Screen Time). دسترسی «خاص» است و کاربر در صفحه‌ی
      رسمی تنظیمات اندروید آن را فعال می‌کند؛ فقط آمار می‌دهد، نه دسترسی به محتوا.
      هیچ enforcement/مسدودسازی با آن انجام نمی‌شود.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!--
      Phase 4: موقعیت مکانی — فقط مجوزهای رسمی و لازم:
      FINE/COARSE برای fix دقیق/تقریبی و BACKGROUND فقط چون قابلیت
      «اشتراک موقعیت وقتی اپ بسته است» نیاز واقعی دارد (جریان دو مرحله‌ای رسمی اندروید).
      بدون Foreground Service ⇒ هیچ notification اجباری ساخته نمی‌شود.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- SOS tracking uses a visible, user-started location foreground service only while SOS is active. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Narrow package visibility for managed Chrome capability detection. -->
    <queries>
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:name=".GlChildApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gl">

        <!--
          Optional Android Enterprise Device Owner component. Merely declaring/enabling this
          receiver does not create Owner status. Only a managed provisioning flow can do that;
          app suspension is guarded by DevicePolicyManager.isDeviceOwnerApp() at runtime.
        -->
        <receiver
            android:name="ir.guardianlink.feature.childstatus.GuardianDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name="ir.guardianlink.feature.childstatus.SosLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
