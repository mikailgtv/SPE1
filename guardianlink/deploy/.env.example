# این فایل فقط برای Compose محلی/آزمایشی است؛ برای AWS staging/production از Secrets Manager و task config مستقل استفاده کنید.
# این فایل را به .env کپی کنید و secrets را محلی و خارج از Git وارد کنید.
APP_ENV=development
LOG_LEVEL=INFO
DB_USER=guardian_migrator
DB_PASS=
DOMAIN=api.replace-with-your-owned-domain.tld
# فقط برای محیط توسعه؛ روی محیط production به 0.0.0.0 تغییر ندهید.
SERVER_BIND_ADDRESS=127.0.0.1
# ثانیه؛ برای تست سریع روی گوشی مقدار کم بگذارید مثلا 180
PRESENCE_LEASE_SEC=1200
PAIRING_TTL_SEC=300
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
# Phase 2 — آستانه‌ها (پیش‌فرض‌ها؛ پر-خانواده از UI والد هم قابل تغییرند)
BATTERY_LOW_PCT=30
BATTERY_CRITICAL_PCT=15
SYNC_DELAYED_SEC=1800
OFFLINE_SEC=3600
HEARTBEAT_INTERVAL_SEC=900
# Phase 4 — Location: آستانه‌ی «کهنگی» آخرین موقعیت (ثانیه)؛ بعد از آن health=delayed
LOCATION_STALE_SEC=3600
# Phase 5 — Geofence (موتور سمت سرور)
GEO_COOLDOWN_SEC=300
GEO_MIN_ACC_M=500
GEO_MAX_ZONES=50
GEO_MIN_RADIUS_M=50
GEO_MAX_RADIUS_M=5000
GEO_EVENT_RETENTION_DAYS=30
