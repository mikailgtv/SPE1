# Template only; use AWS Secrets Manager and task role, not a committed .env.
APP_ENV=production
LOG_LEVEL=INFO
DB_URL=jdbc:postgresql://<production-rds-host>:5432/guardianlink?sslmode=verify-full
DB_USER=
DB_PASS=
DATA_DIR=/data
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
