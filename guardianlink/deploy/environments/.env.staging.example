# Template only; inject DB_USER/DB_PASS from staging secret manager at runtime.
APP_ENV=staging
LOG_LEVEL=INFO
DB_URL=jdbc:postgresql://<staging-rds-host>:5432/guardianlink?sslmode=verify-full
DB_USER=
DB_PASS=
DATA_DIR=/data
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
# Never use production data. Migration/runtime DB role separation remains a blocker.
